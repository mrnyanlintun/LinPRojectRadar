# Python virtual environments
venv/
.venv/
env/

# Python bytecode
__pycache__/
*.py[cod]
*.pyd

# Agent worktrees
.claude/worktrees/

# Secrets. The tracked backend/.env.example template is preserved below.
.env
.env.*
!.env.example

# Local databases
dev.db
*.sqlite3

# Generated by server/tools/dev_serve.py for local runs only.
server/dev_fixtures/

# NOTE: p0-baseline/ is deliberately NOT ignored. Its contents are captured
# evidence of what the live endpoint reported and must be committed.

# research fixture scratch and regeneration areas, never the authoritative package
research_fixtures/**/_scratch/
research_fixtures/**/_regen/
research_fixtures/**/*.tmp

# RUN 135C, M14. Generators write here by default; the committed artefact is only
# overwritten with --write-artifact. See server/tools/artifact_write.py.
.artifact_scratch/
